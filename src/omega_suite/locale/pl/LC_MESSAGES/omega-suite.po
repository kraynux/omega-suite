msgstr "URUCHOMIĆ PONOWNIE OMEGA-SUITE?"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:116
#, python-brace-format
msgid "{setting_label} modifié - ne s'applique qu'au démarrage. Fermer puis relancer omega-suite tout de suite ?"
msgstr "Zmieniono {setting_label} - działa dopiero przy uruchomieniu. Zamknąć i ponownie uruchomić omega-suite teraz?"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:149
msgid "VIDER TOUS LES EXPORTS ?"
msgstr "WYCZYŚCIĆ WSZYSTKIE EKSPORTY?"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:151
msgid "Le dossier d'export des 7 outils (celui choisi dans les réglages de chaque outil) sera définitivement vidé (rien d'autre n'est touché)."
msgstr "Katalog eksportu 7 narzędzi (wybrany w ustawieniach każdego narzędzia) zostanie trwale opróżniony (nic innego nie zostanie zmienione)."

