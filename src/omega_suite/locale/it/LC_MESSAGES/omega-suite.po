msgstr "IMPOSTAZIONI DELLA SUITE"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:65
msgid "Style de navigation (redémarrage requis)"
msgstr "Stile di navigazione (riavvio necessario)"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:77
msgid "Vider tous les exports"
msgstr "Svuota tutte le esportazioni"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:101
msgid "Style de navigation"
