#: src/omega_suite/interfaces/tui/screens/settings_screen.py:149
msgid "VIDER TOUS LES EXPORTS ?"
msgstr "SVUOTARE TUTTE LE ESPORTAZIONI?"

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:151
msgid "Le dossier d'export des 7 outils (celui choisi dans les réglages de chaque outil) sera définitivement vidé (rien d'autre n'est touché)."
msgstr "La cartella di esportazione dei 7 strumenti (quella scelta nelle impostazioni di ogni strumento) sarà svuotata definitivamente (nient'altro viene toccato)."

