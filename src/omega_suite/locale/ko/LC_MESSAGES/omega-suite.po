msgstr "도구 {count}개의 내보내기를 비웠습니다."

#: src/omega_suite/interfaces/tui/screens/settings_screen.py:181
#, python-brace-format
msgid "Exports vidés pour {count} outil(s), {count2} problème(s) : {shown}"
msgstr "도구 {count}개의 내보내기를 비웠습니다. 문제 {count2}건: {shown}"

#: src/omega_suite/interfaces/tui/language_setting.py:65
